generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── 유저 ───────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  nickname      String   @unique
  passwordHash  String
  phone         String?  @unique
  avatarUrl     String?
  balance       Int      @default(0) // 보유 포인트/머니
  role          UserRole @default(USER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  listings        Listing[]
  bids            Bid[]
  autoBids        AutoBid[]
  offersGiven     Offer[]         @relation("OfferBuyer")
  transactions    Transaction[]   @relation("TransactionBuyer")
  sales           Transaction[]   @relation("TransactionSeller")
  oripaPurchases  OripaPurchase[]
  inventoryItems      InventoryItem[]
  shippingRequests    ShippingRequest[]
  withdrawalRequests  WithdrawalRequest[]
  chatRoomsAsBuyer    ChatRoom[]          @relation("ChatBuyer")
  chatRoomsAsSeller   ChatRoom[]          @relation("ChatSeller")
  chatMessages        ChatMessage[]       @relation("ChatMessages")
  passwordResetTokens PasswordResetToken[]
  shopOrders          ShopOrder[]
  cartItems           CartItem[]
  shopPurchases       ShopPurchase[]
  shopReviews         ShopReview[]
  posts               Post[]
  comments            Comment[]
  adminPermissions    AdminPermission[]
  postLikes           PostLike[]
  postScraps          PostScrap[]
  commentLikes        CommentLike[]
  reportsGiven        Report[]    @relation("ReportReporter")
  reportsReceived     Report[]    @relation("ReportedUser")
  friendRequestsSent     FriendRequest[] @relation("FriendRequestsSent")
  friendRequestsReceived FriendRequest[] @relation("FriendRequestsReceived")
  friendRoomsAsUser1     FriendRoom[]    @relation("FriendRoomUser1")
  friendRoomsAsUser2     FriendRoom[]    @relation("FriendRoomUser2")
  friendMessages         FriendMessage[] @relation("FriendMessages")

  // 평점/리뷰
  avgRating       Float?
  reviewCount     Int      @default(0)
  reviewsGiven    Review[] @relation("ReviewsGiven")
  reviewsReceived Review[] @relation("ReviewsReceived")

  // 알림
  notifications        Notification[]
  emailNotifications   Boolean  @default(true)  // 이메일 알림 수신 여부

  // 이메일 인증
  emailVerified        Boolean  @default(false)
  emailVerifyToken     String?  @unique
  emailVerifyExpires   DateTime?

  // 2단계 인증 (TOTP)
  twoFaEnabled         Boolean  @default(false)
  twoFaSecret          String?

  // 리프레시 토큰
  refreshTokens        RefreshToken[]

  // 위시리스트
  wishlists       Wishlist[]

  // 사기 방지
  warningCount         Int      @default(0)   // 경고 누적 횟수
  isSuspended          Boolean  @default(false) // 계정 정지
  suspendedAt          DateTime?
  suspendedReason      String?

  disputes             Dispute[] @relation("DisputeBuyer")
  disputesAsSeller     Dispute[] @relation("DisputeSeller")
}

model RefreshToken {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PhoneOtp {
  id        String   @id @default(uuid())
  phone     String
  otp       String
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone])
}

enum UserRole {
  USER
  ADMIN        // 중간 관리자
  SUPER_ADMIN  // 최종 관리자
}

// ─── 카드 ────────────────────────────────────────────────────────────────

model Card {
  id          String      @id @default(uuid())
  name        String
  tcgType     TcgType
  setName     String      // 세트/팩 이름
  setCode     String?     // 공식 세트 코드
  cardNumber  String?     // 카드 번호
  rarity      String      // C, UC, R, RR, SR, HR, UR 등
  imageUrl    String?
  description String?
  externalId  String?     @unique  // 외부 API 중복 방지 키
  nameKo      String?              // 한국어 카드명 (검색용)
  nameJa      String?              // 일본어 카드명 (검색용)
  createdAt   DateTime    @default(now())

  // 포켓몬/TCG 상세 스탯 (pokemontcg.io, YGOProDeck, Scryfall 등)
  supertype   String?   // "Pokémon" | "Trainer" | "Energy" | "Monster" | "Spell" | "Trap"
  subtypes    String?   // "Basic,V" 쉼표 구분 서브타입
  cardTypes   String?   // "Fire,Psychic" 에너지/속성 타입 (쉼표 구분)
  hp          Int?      // 포켓몬 HP
  attacks     Json?     // [{name, cost:[], damage, text}]
  abilities   Json?     // [{name, text, type}]
  weaknesses  Json?     // [{type, value}]
  resistances Json?     // [{type, value}]
  retreatCost Int?      // 후퇴 비용
  artist      String?   // 일러스트레이터
  flavorText  String?   // 풀레이버 텍스트
  stage          String?   // 진화 단계: Basic | Stage 1 | Stage 2 | ... (포켓몬)
  evolvesFrom    String?   // 진화 전 포켓몬 이름 (카드와 같은 언어)
  dexIds         Int[]     @default([])  // 전국 도감 번호
  regulationMark String?   // 레귤레이션 마크 (G, H, I, J ...)
  detailSyncedAt DateTime? // 외부 상세 정보 보강 시각 (null = 아직)
  stats          Json?     // TCG별 스탯 (유희왕 ATK/DEF·레벨, 디지몬 DP·레벨, MTG 마나·P/T 등)
  textKo         Json?     // 한국어 텍스트 { attacks, abilities, effect, flavor, typeLine, ... } — 원문 필드와 같은 구조
  textKoSource   String?   // OFFICIAL(공식 한글) | DICT(사전 번역) | PARTIAL(일부만 번역)

  // 스니덩 (snkrdunk.com) 마켓 데이터
  snkrdunkPrice    Int?    // 최저 호가 (KRW), null=아직 미조회
  snkrdunkListings String? // 리스팅 수 ("0", "5", "99+" 등)
  snkrdunkUpdatedAt DateTime? // 마지막 스니덩 가격 업데이트

  listings        Listing[]
  oripaItems      OripaItem[]
  inventoryItems  InventoryItem[]
  wishlists       Wishlist[]
  sourceItems     CardSourceItem[]
  priceSnapshots  CardPriceSnapshot[]

  @@index([tcgType])
  @@index([name])
  @@index([nameKo])
  @@index([nameJa])
  @@index([supertype])
  @@index([cardTypes])
  @@index([tcgType, setCode])
  @@index([regulationMark])
  @@index([evolvesFrom])
}

// 포켓몬 도감 (PokeAPI, 한국어 이름·분류·도감 설명)
model PokemonSpecies {
  dexId            Int      @id
  nameKo           String
  nameJa           String?
  nameEn           String
  genusKo          String?  // 분류 (예: 쥐포켓몬)
  flavorKo         String?  // 도감 설명 (최신 게임 기준)
  heightDm         Int?     // 키 (데시미터)
  weightHg         Int?     // 몸무게 (헥토그램)
  types            String[] @default([])
  generation       Int?
  evolvesFromDexId Int?
  updatedAt        DateTime @updatedAt

  @@index([nameKo])
  @@index([nameJa])
  @@index([nameEn])
}

// 한국어 사전 (일본어·영어 → 한국어). PokeAPI 이름 + 공식 한판·일판 카드 문장 짝으로 구축
model KoDictEntry {
  id        String   @id @default(uuid())
  kind      String   // POKEMON | MOVE | ABILITY | CARD_NAME | ATTACK_NAME | ABILITY_NAME | EFFECT
  srcLang   String   // ja | en
  src       String   // 정규화한 원문 (공백 제거·NFKC)
  ko        String
  source    String   // POKEAPI | TCGDEX_KO | MANUAL
  hits      Int      @default(1)   // 같은 짝이 관측된 횟수
  updatedAt DateTime @updatedAt

  @@unique([kind, srcLang, src])
}

// 세트(확장팩) 메타데이터 — 카드의 (tcgType, setCode, 언어)와 대응
model CardSet {
  id            String    @id @default(uuid())
  tcgType       TcgType
  lang          String    // ja | ko | en
  code          String    // 카드의 setCode와 같은 값
  name          String
  series        String?
  releaseDate   DateTime?
  logoUrl       String?
  symbolUrl     String?
  officialCount Int?      // 공식 카드 수 (시크릿 제외)
  totalCount    Int?      // 시크릿 포함 전체
  source        String    // TCGDEX | POKEMONTCG
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([tcgType, lang, code])
  @@index([tcgType, releaseDate])
}

enum TcgType {
  POKEMON
  YUGIOH
  MTG
  DIGIMON
  ONEPIECE
  WEISS
  OTHER
}

// ─── 외부 소스 상품 ↔ 카드 연결 (연결 표 + 매칭 검수함) ───────────────────
// 외부 상품 1건당 1행. 확실한 매칭(세트+번호 일치)만 자동 연결하고,
// 나머지는 PENDING으로 쌓아 관리자가 연결/신규 등록/무시를 결정한다.

enum CardSource {
  SNKRDUNK
}

enum CardSourceStatus {
  PENDING   // 검수 대기
  LINKED    // 카드와 연결됨
  IGNORED   // 무시 (동기화 때 가격만 갱신, 매칭 안 함)
}

enum CardMatchMethod {
  AUTO      // 세트+번호 일치로 자동 연결
  MANUAL    // 관리자가 기존 카드에 연결
  CREATED   // 관리자가 신규 카드로 등록
  LEGACY    // 이전 임포터가 만든 snkrdunk_* 카드
}

model CardSourceItem {
  id           String           @id @default(uuid())
  source       CardSource
  externalId   String           // 소스 쪽 상품 ID
  tcgType      TcgType
  lang         String?          // ja | en | ko
  productCode  String?          // 소스 상품 코드 (pkmn-tcg-SV3a-079)
  rawName      String           // 소스 원본 상품명
  name         String           // 파싱한 카드명
  setName      String?
  setCode      String?
  cardNumber   String?
  rarity       String?
  imageUrl     String?

  price          Int?           // 최저 호가 (KRW, 0 = 매물 없음)
  listings       String?        // 매물 수 ("0", "5", "99+")
  priceUpdatedAt DateTime?

  status       CardSourceStatus @default(PENDING)
  matchMethod  CardMatchMethod?
  cardId       String?
  card         Card?            @relation(fields: [cardId], references: [id], onDelete: SetNull)
  resolvedById String?          // 수동 처리한 관리자
  resolvedAt   DateTime?

  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([source, externalId])
  @@index([status, source, tcgType])
  @@index([cardId])
}

// 카드별 외부 시세 일일 스냅샷 (KST 날짜 기준 하루 1행, 매물 있는 최저 호가)
model CardPriceSnapshot {
  id        String     @id @default(uuid())
  cardId    String
  card      Card       @relation(fields: [cardId], references: [id], onDelete: Cascade)
  source    CardSource
  date      DateTime   @db.Date
  price     Int
  listings  String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([cardId, source, date])
  @@index([source, date])
}

// 외부 소스 동기화 실행 기록 (중복 실행 방지 락 + 관리자 모니터링)
enum SyncRunStatus {
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

enum SyncTrigger {
  SCHEDULE
  MANUAL
}

model SyncRun {
  id            String        @id @default(uuid())
  source        CardSource
  trigger       SyncTrigger
  status        SyncRunStatus @default(RUNNING)
  triggeredById String?
  startedAt     DateTime      @default(now())
  heartbeatAt   DateTime      @default(now())   // 진행 중 갱신, 오래 멈추면 비정상 종료로 간주
  finishedAt    DateTime?
  stats         Json?
  warnings      String[]      @default([])
  error         String?

  @@index([source, startedAt])
}

// ─── 거래 리스팅 ─────────────────────────────────────────────────────────

model Listing {
  id            String        @id @default(uuid())
  seller        User          @relation(fields: [sellerId], references: [id])
  sellerId      String
  card          Card          @relation(fields: [cardId], references: [id])
  cardId        String
  listingType   ListingType
  condition     CardCondition
  quantity      Int           @default(1)
  imageUrls     String[]      // 실물 사진
  description   String?

  // 즉시구매
  buyNowPrice   Int?

  // 경매
  startingPrice     Int?
  currentPrice      Int?
  auctionEndsAt     DateTime?
  instantBuyPrice   Int?      // 경매 즉시낙찰가 (이 금액 이상 입찰 시 즉시 낙찰)
  autoExtendMinutes Int?      // 스나이핑 방지: 마감 N분 전 입찰 시 N분 자동 연장
  autoExtendCount   Int       @default(0)
  maxAutoExtends    Int       @default(3)

  // 가격제안
  minOfferPrice Int?

  // 그레이딩 (없으면 null → UI에서 "None" 표시)
  gradingCompany String?  // PSA | BGS | CGC | SGC | HGA | ACE | 기타 | null
  gradingGrade   String?  // "10", "9.5", "8" 등

  status        ListingStatus @default(ACTIVE)
  viewCount     Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  bids          Bid[]
  autoBids      AutoBid[]
  offers        Offer[]
  transaction   Transaction?
  chatRooms     ChatRoom[]
  reports       Report[]

  @@index([listingType])
  @@index([status])
  @@index([cardId])
  @@index([sellerId])
  @@index([createdAt])
  @@index([viewCount])
  @@index([status, listingType])
  @@index([status, listingType, auctionEndsAt])
  @@index([condition])
}

enum ListingType {
  BUY_NOW       // 즉시구매
  AUCTION       // 경매
  OFFER         // 가격제안
}

enum CardCondition {
  MINT          // 미개봉/완전무결
  NEAR_MINT     // 거의 민트
  EXCELLENT     // 매우 좋음
  GOOD          // 좋음
  LIGHT_PLAYED  // 약간 사용
  PLAYED        // 사용
  POOR          // 불량
}

enum ListingStatus {
  ACTIVE        // 거래 중
  SOLD          // 판매 완료
  CANCELLED     // 취소
  EXPIRED       // 만료 (경매)
  SUSPENDED     // 신고 누적으로 자동 숨김
}

// ─── 경매 입찰 ───────────────────────────────────────────────────────────

model Bid {
  id        String   @id @default(uuid())
  listing   Listing  @relation(fields: [listingId], references: [id])
  listingId String
  bidder    User     @relation(fields: [bidderId], references: [id])
  bidderId  String
  amount    Int
  isAuto    Boolean  @default(false)
  isWinning Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([listingId])
  @@index([bidderId])
}

// ─── 자동 입찰 ────────────────────────────────────────────────────────────────

model AutoBid {
  id        String   @id @default(uuid())
  listing   Listing  @relation(fields: [listingId], references: [id])
  listingId String
  bidder    User     @relation(fields: [bidderId], references: [id])
  bidderId  String
  maxAmount Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([listingId, bidderId])
  @@index([listingId, isActive])
  @@index([bidderId])
}

// ─── 가격 제안 ───────────────────────────────────────────────────────────

model Offer {
  id        String      @id @default(uuid())
  listing   Listing     @relation(fields: [listingId], references: [id])
  listingId String
  buyer     User        @relation("OfferBuyer", fields: [buyerId], references: [id])
  buyerId   String
  amount    Int
  message   String?
  status    OfferStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([listingId])
  @@index([buyerId])
  @@index([status])
}

enum OfferStatus {
  PENDING   // 대기
  ACCEPTED  // 수락
  DECLINED  // 거절
  WITHDRAWN // 철회
}

// ─── 거래 내역 ───────────────────────────────────────────────────────────

model Transaction {
  id               String            @id @default(uuid())
  listing          Listing           @relation(fields: [listingId], references: [id])
  listingId        String            @unique
  buyer            User              @relation("TransactionBuyer", fields: [buyerId], references: [id])
  buyerId          String
  seller           User              @relation("TransactionSeller", fields: [sellerId], references: [id])
  sellerId         String
  finalPrice       Int

  // 번개장터식 거래 단계
  txStatus         TxStatus          @default(PENDING_SHIPMENT)

  // 배송 정보 (판매자 입력)
  trackingCarrier  String?           // 택배사
  trackingNumber   String?           // 운송장 번호
  shippedAt        DateTime?         // 발송 처리 시각

  // 정산 정보
  escrowStatus     EscrowStatus      @default(HELD)
  escrowReleasedAt DateTime?
  confirmedAt      DateTime?         // 구매자 수령 확인 시각

  // 분쟁 정보
  disputeStatus    DisputeStatus?
  disputedAt       DateTime?

  completedAt      DateTime          @default(now())

  chatRoom         ChatRoom?
  reports          Report[]
  reviews          Review[]
  dispute          Dispute?

  @@index([buyerId])
  @@index([sellerId])
  @@index([completedAt])
  @@index([txStatus])
  @@index([escrowStatus])
  @@index([txStatus, escrowStatus, shippedAt])
}

enum TxStatus {
  PENDING_SHIPMENT  // 결제 완료, 판매자 발송 대기
  SHIPPED           // 판매자 발송 완료, 구매자 수령 대기
  COMPLETED         // 구매자 수령 확인 → 거래 완료
  AUTO_COMPLETED    // 자동 구매 확정 (발송 후 7일)
  CANCELLED         // 취소
  AUTO_CANCELLED    // 미발송으로 자동 취소 (발송 기한 3일 초과)
  DISPUTED          // 분쟁 중
}

enum EscrowStatus {
  HELD          // 에스크로 보관 중
  RELEASED      // 정산 완료
  AUTO_RELEASED // 자동 정산
  REFUNDED      // 환불됨 (미발송 자동 취소 or 분쟁 환불)
}

enum DisputeStatus {
  OPEN       // 분쟁 접수
  REVIEWING  // 검토 중
  RESOLVED   // 해결됨 (구매자 승)
  REJECTED   // 기각 (판매자 승)
  REFUNDED   // 환불 완료
}

model Dispute {
  id            String        @id @default(uuid())
  transaction   Transaction   @relation(fields: [transactionId], references: [id])
  transactionId String        @unique
  buyer         User          @relation("DisputeBuyer",  fields: [buyerId],  references: [id])
  buyerId       String
  seller        User          @relation("DisputeSeller", fields: [sellerId], references: [id])
  sellerId      String
  reason        ReportReason
  description   String
  evidenceUrls  String[]      @default([])
  status        DisputeStatus @default(OPEN)
  adminNote     String?
  resolvedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
}

enum ReportReason {
  FAKE_ITEM    // 가짜/위조 카드
  NO_SHIPMENT  // 미발송/잠수
  WRONG_ITEM   // 다른 물품 발송
  DAMAGED_ITEM // 손상 물품 발송
  FRAUD        // 사기 의심
  HARASSMENT   // 괴롭힘/욕설
  OTHER        // 기타
}

enum ReportStatus {
  PENDING       // 접수됨
  INVESTIGATING // 조사 중
  RESOLVED      // 해결됨
  DISMISSED     // 기각됨
}

// ─── 채팅 ─────────────────────────────────────────────────────────────────────

model ChatRoom {
  id            String        @id @default(uuid())
  listingId     String
  listing       Listing       @relation(fields: [listingId], references: [id])
  buyerId       String
  buyer         User          @relation("ChatBuyer", fields: [buyerId], references: [id])
  sellerId      String
  seller        User          @relation("ChatSeller", fields: [sellerId], references: [id])
  transactionId String?       @unique
  transaction   Transaction?  @relation(fields: [transactionId], references: [id])
  messages      ChatMessage[]
  lastMessageAt DateTime?
  createdAt     DateTime      @default(now())

  @@unique([listingId, buyerId])
  @@index([buyerId])
  @@index([sellerId])
}

model ChatMessage {
  id        String   @id @default(uuid())
  room      ChatRoom @relation(fields: [roomId], references: [id])
  roomId    String
  senderId  String
  sender    User     @relation("ChatMessages", fields: [senderId], references: [id])
  content   String
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([roomId, createdAt])
}

// ─── 오리파 ──────────────────────────────────────────────────────────────

model Oripa {
  id          String      @id @default(uuid())
  title       String
  description String?
  imageUrl    String?
  pricePerDraw Int        // 1회 뽑기 가격
  totalSlots  Int         // 전체 슬롯 수
  remainSlots Int         // 남은 슬롯 수
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items       OripaItem[]
  purchases   OripaPurchase[]
}

model OripaItem {
  id        String  @id @default(uuid())
  oripa     Oripa   @relation(fields: [oripaId], references: [id])
  oripaId   String
  card      Card    @relation(fields: [cardId], references: [id])
  cardId    String
  quantity  Int     @default(1)
  grade     Int     @default(1) // 등급 (1=일반, 2=레어, 3=최상위)
  weight    Int     @default(0) // 커스텀 가중치 (0=등급 기반 자동)
  isLastOne Boolean @default(false) // 라스트 원 보장 아이템

  @@index([oripaId])
}

// ─── 결제 로그 (중복 결제 방지용) ────────────────────────────────────────────

model PaymentLog {
  id         String   @id @default(uuid())
  orderId    String   @unique  // 토스페이먼츠 orderId (멱등성 키)
  userId     String
  amount     Int
  status     String   @default("SUCCESS")
  createdAt  DateTime @default(now())

  @@index([userId])
}

// ─── 인벤토리 ─────────────────────────────────────────────────────────────

model InventoryItem {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  cardId          String
  card            Card           @relation(fields: [cardId], references: [id])
  quantity        Int            @default(1)
  source          ItemSource
  sourceId        String?        // Transaction.id 또는 OripaPurchase.id
  condition       CardCondition?
  gradingCompany  String?
  gradingGrade    String?
  imageUrls       String[]       @default([])
  note            String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  shippingItems   ShippingRequestItem[]

  @@index([userId])
  @@index([cardId])
}

enum ItemSource {
  PURCHASE
  ORIPA
}

model ShippingRequest {
  id              String                @id @default(uuid())
  userId          String
  user            User                  @relation(fields: [userId], references: [id])
  items           ShippingRequestItem[]
  recipientName   String
  phone           String
  zipCode         String
  address         String
  addressDetail   String?
  memo            String?
  status          ShippingStatus        @default(PENDING)
  trackingNumber  String?
  courier         String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([userId])
  @@index([status])
}

model ShippingRequestItem {
  id                String          @id @default(uuid())
  shippingRequestId String
  shippingRequest   ShippingRequest @relation(fields: [shippingRequestId], references: [id], onDelete: Cascade)
  inventoryItemId   String
  inventoryItem     InventoryItem   @relation(fields: [inventoryItemId], references: [id])
  quantity          Int             @default(1)
}

enum ShippingStatus {
  PENDING     // 신청됨
  PROCESSING  // 처리 중
  SHIPPED     // 발송됨
  DELIVERED   // 배송 완료
  CANCELLED   // 취소
}

// ─── 환전 신청 ────────────────────────────────────────────────────────────

model WithdrawalRequest {
  id              String           @id @default(uuid())
  user            User             @relation(fields: [userId], references: [id])
  userId          String
  amount          Int              // 환전 신청 금액 (포인트)
  bankName        String           // 은행명
  accountNumber   String           // 계좌번호
  accountHolder   String           // 예금주
  status          WithdrawalStatus @default(PENDING)
  adminNote       String?          // 거절 사유 등
  transferId      String?          // 이체 트랜잭션 ID (Toss 등)
  transferError   String?          // 이체 실패 메시지
  processedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

enum WithdrawalStatus {
  PENDING    // 대기 중
  APPROVED   // 승인 (송금 처리 중)
  COMPLETED  // 완료 (송금 완료)
  REJECTED   // 거절 (잔액 환불)
  CANCELLED  // 취소 (사용자, 잔액 환불)
}

model OripaPurchase {
  id        String   @id @default(uuid())
  oripa     Oripa    @relation(fields: [oripaId], references: [id])
  oripaId   String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  draws     Int      // 뽑기 횟수
  results   Json     // 뽑기 결과 (카드 목록)
  totalPaid Int
  createdAt DateTime @default(now())

  @@index([oripaId])
  @@index([userId])
}

// ─── 관리자 샵 (TCG 박스 판매) ─────────────────────────────────────────────

model ShopItem {
  id          String       @id @default(uuid())
  name        String
  description String?
  tcgType     TcgType
  category    ShopCategory
  price       Int                    // 포인트
  stock       Int          @default(0)
  imageUrl    String?
  isActive    Boolean      @default(true)
  isSoldOut   Boolean      @default(false)  // 명시적 품절 (재고와 무관하게 관리자가 토글)
  originalPrice Int?                        // 정가 (판매가보다 높으면 할인 표시)
  images      String[]     @default([])     // 추가 이미지 (상세 갤러리)
  isFeatured  Boolean      @default(false)  // 메인 배너·추천 상품
  soldCount   Int          @default(0)      // 누적 판매 수량 (베스트 정렬)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  orders      ShopOrder[]
  cartItems   CartItem[]
  reviews     ShopReview[]

  @@index([tcgType])
  @@index([isActive])
  @@index([isSoldOut])
  @@index([soldCount])
}

enum ShopCategory {
  BOOSTER_BOX   // 부스터 박스
  STARTER_DECK  // 스타터 덱
  SINGLE_PACK   // 단품 팩
  GIFT_SET      // 기프트 세트
  SPECIAL       // 특별판/프리미엄
  OTHER         // 기타
}

// ─── 사이트 설정 ─────────────────────────────────────────────────────────────

model SiteConfig {
  key   String @id
  value String
}

// ─── 관리자 권한 ─────────────────────────────────────────────────────────────

model AdminPermission {
  id      String @id @default(uuid())
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String
  section String // 'posts' | 'cards' | 'shop' | 'oripas' | 'shipping' | 'withdrawal'

  @@unique([userId, section])
  @@index([userId])
}

// ─── 사이트 메뉴 설정 ───────────────────────────────────────────────────────

model SiteMenu {
  id      String  @id @default(uuid())
  key     String  @unique
  label   String
  path    String
  enabled Boolean @default(true)
  order   Int     @default(0)
}

// ─── 게시판 ───────────────────────────────────────────────────────────────

enum PostType {
  NOTICE
  EVENT
  COMMUNITY
}

// 커뮤니티(카페) 게시판 분류
enum BoardCategory {
  FREE      // 자유게시판
  SHOWOFF   // 카드 자랑
  INFO      // 정보 · 공략
  QNA       // 질문 답변
  REVIEW    // 거래 후기
}

enum ContentFormat {
  TEXT   // 일반 텍스트 + 이미지 줄 토큰 (구형)
  HTML   // 서식 에디터 (서버에서 sanitize 후 저장)
}

// 게시판 권한 단계: 활동 등급 이상 / 운영진만
enum BoardPermission {
  ALL
  MEMBER
  GOOD
  DEVOTED
  VIP
  ADMIN
}

model BoardSetting {
  category          BoardCategory   @id
  writePermission   BoardPermission @default(ALL)
  commentPermission BoardPermission @default(ALL)
  updatedAt         DateTime        @updatedAt
}

model PostScrap {
  postId    String
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([postId, userId])
  @@index([userId, createdAt])
}

// 조회수 중복 방지 (viewerKey = 유저 id 또는 IP 해시)
model PostView {
  postId    String
  viewerKey String
  viewedAt  DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([postId, viewerKey])
  @@index([viewedAt])
}

model Post {
  id           String    @id @default(uuid())
  type         PostType
  title        String
  content      String
  contentFormat ContentFormat @default(TEXT)
  contentText  String?   // 검색용 평문 (HTML 태그 제거)
  author       User      @relation(fields: [authorId], references: [id])
  authorId     String
  pinned       Boolean   @default(false)
  viewCount    Int       @default(0)
  imageUrl     String?
  imageUrls    String[]  @default([])   // 본문 첨부 이미지 (커뮤니티)
  category     BoardCategory?           // 커뮤니티 게시판 분류 (공지/이벤트는 null)
  tcgType      TcgType?  // 커뮤니티 게시글 TCG 카테고리 (선택)
  eventStartAt DateTime?
  eventEndAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  comments     Comment[]
  likes        PostLike[]
  scraps       PostScrap[]
  views        PostView[]

  @@index([type])
  @@index([type, tcgType])
  @@index([type, category, createdAt])
  @@index([authorId])
  @@index([pinned])
  @@index([createdAt])
}

model PostLike {
  postId    String
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@id([postId, userId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(uuid())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  likes     CommentLike[]

  // 답글(대댓글) — 1단계만 허용
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  parentId  String?
  replies   Comment[] @relation("CommentReplies")
  deletedAt DateTime? // 답글이 달린 댓글은 내용만 지우고 자리를 남김

  @@index([postId])
  @@index([parentId])
  @@index([authorId])
}

model CommentLike {
  commentId String
  userId    String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@id([commentId, userId])
  @@index([userId])
}

model ShopOrder {
  id          String          @id @default(uuid())
  user        User            @relation(fields: [userId], references: [id])
  userId      String
  shopItem    ShopItem        @relation(fields: [shopItemId], references: [id])
  shopItemId  String
  quantity    Int             @default(1)
  unitPrice   Int
  totalPrice  Int

  recipientName  String?
  recipientPhone String?
  zipCode        String?
  address        String?
  addressDetail  String?
  shippingMemo   String?
  shippingStatus ShopOrderStatus @default(PENDING)
  trackingNumber String?
  courier        String?

  purchaseId  String?         // 한 번에 결제한 주문 묶음 (장바구니 주문)
  purchase    ShopPurchase?   @relation(fields: [purchaseId], references: [id])
  review      ShopReview?

  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([shopItemId])
  @@index([shippingStatus])
  @@index([createdAt])
  @@index([purchaseId])
}

// 장바구니
model CartItem {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  shopItem   ShopItem @relation(fields: [shopItemId], references: [id], onDelete: Cascade)
  shopItemId String
  quantity   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, shopItemId])
}

// 한 번의 결제 (여러 상품 + 배송비). 상품별 배송 처리는 ShopOrder 단위로 유지
model ShopPurchase {
  id             String      @id @default(uuid())
  orderNo        String      @unique   // 고객에게 보여주는 주문번호
  user           User        @relation(fields: [userId], references: [id])
  userId         String
  itemsTotal     Int
  shippingFee    Int
  totalPaid      Int
  recipientName  String
  recipientPhone String
  zipCode        String
  address        String
  addressDetail  String?
  shippingMemo   String?
  createdAt      DateTime    @default(now())

  orders         ShopOrder[]

  @@index([userId, createdAt])
}

// 구매 후기 (주문 상품 1건당 1개)
model ShopReview {
  id         String    @id @default(uuid())
  shopItem   ShopItem  @relation(fields: [shopItemId], references: [id], onDelete: Cascade)
  shopItemId String
  user       User      @relation(fields: [userId], references: [id])
  userId     String
  order      ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String    @unique
  rating     Int       // 1~5
  content    String
  createdAt  DateTime  @default(now())

  @@index([shopItemId, createdAt])
}

enum ShopOrderStatus {
  PENDING    // 결제 완료, 배송 준비 중
  PREPARING  // 포장 중
  SHIPPED    // 발송 완료
  DELIVERED  // 배송 완료
}

// ─── 신고 ─────────────────────────────────────────────────────────────────────

model Report {
  id             String       @id @default(uuid())
  reporter       User         @relation("ReportReporter", fields: [reporterId], references: [id])
  reporterId     String
  reportedUser   User         @relation("ReportedUser",  fields: [reportedUserId], references: [id])
  reportedUserId String
  listing        Listing?     @relation(fields: [listingId], references: [id])
  listingId      String?
  transaction    Transaction? @relation(fields: [transactionId], references: [id])
  transactionId  String?
  reason         ReportReason
  detail         String?
  status         ReportStatus @default(PENDING)
  adminNote      String?
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([status])
  @@index([createdAt])
}

// ─── 친구 ──────────────────────────────────────────────────────────────────────

model FriendRequest {
  id         String              @id @default(uuid())
  sender     User                @relation("FriendRequestsSent",     fields: [senderId],   references: [id], onDelete: Cascade)
  senderId   String
  receiver   User                @relation("FriendRequestsReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  receiverId String
  status     FriendRequestStatus @default(PENDING)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@index([senderId, status])
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model FriendRoom {
  id            String          @id @default(uuid())
  user1         User            @relation("FriendRoomUser1", fields: [user1Id], references: [id])
  user1Id       String
  user2         User            @relation("FriendRoomUser2", fields: [user2Id], references: [id])
  user2Id       String
  messages      FriendMessage[]
  lastMessageAt DateTime?
  createdAt     DateTime        @default(now())

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
}

model FriendMessage {
  id        String     @id @default(uuid())
  room      FriendRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId    String
  sender    User       @relation("FriendMessages", fields: [senderId], references: [id])
  senderId  String
  content   String
  readAt    DateTime?
  createdAt DateTime   @default(now())

  @@index([roomId, createdAt])
  @@index([senderId])
}

// ─── 평점 & 리뷰 ──────────────────────────────────────────────────────────────

model Review {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  reviewerId    String
  reviewer      User        @relation("ReviewsGiven",    fields: [reviewerId],  references: [id])
  revieweeId    String
  reviewee      User        @relation("ReviewsReceived", fields: [revieweeId],  references: [id])
  role          ReviewRole  // 리뷰어의 거래 역할
  rating        Int         // 1 ~ 5
  comment       String?     @db.VarChar(300)
  sellerReply     String?   @db.VarChar(500)
  sellerRepliedAt DateTime?
  createdAt     DateTime    @default(now())

  @@unique([transactionId, reviewerId])
  @@index([revieweeId])
  @@index([reviewerId])
  @@index([transactionId])
}

enum ReviewRole {
  BUYER   // 구매자가 판매자를 평가
  SELLER  // 판매자가 구매자를 평가
}

// ─── 알림 ─────────────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// ─── 위시리스트 ───────────────────────────────────────────────────────────────

model Wishlist {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId      String
  card        Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  targetPrice Int?     // 이 가격 이하 리스팅 등록 시 알림 (null = 알림 없음)
  createdAt   DateTime @default(now())

  @@unique([userId, cardId])
  @@index([userId])
  @@index([cardId])
}

enum NotificationType {
  BID_OUTBID            // 입찰 밀림
  BID_WON               // 낙찰
  OFFER_RECEIVED        // 제안 받음
  OFFER_ACCEPTED        // 제안 수락
  OFFER_REJECTED        // 제안 거절
  TRANSACTION_SHIPPED   // 발송 완료
  TRANSACTION_COMPLETED // 거래 완료
  REVIEW_RECEIVED       // 리뷰 받음
  FRIEND_REQUEST        // 친구 요청
  FRIEND_ACCEPTED       // 친구 수락
  WISHLIST_PRICE_ALERT  // 위시리스트 가격 알림
  COMMUNITY_COMMENT     // 내 글/댓글에 댓글
  SYSTEM                // 시스템 공지
}
