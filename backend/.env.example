DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/rocket_auction"

# 32자 이상 랜덤 문자열 (openssl rand -hex 32)
JWT_SECRET="CHANGE_ME_TO_A_RANDOM_SECRET"

PORT=4000

# 개발: http://localhost:3000 / 프로덕션: https://your-app.vercel.app
FRONTEND_URL="http://localhost:3000"

# 개발: http://localhost:4000 / 프로덕션: https://your-backend.up.railway.app
API_URL="http://localhost:4000"

# ── 토스페이먼츠 ──────────────────────────────────────────────────────────────
# https://developers.tosspayments.com → 내 계정 → API 키
# 테스트: test_sk_ / 라이브: live_sk_
TOSS_SECRET_KEY="test_sk_..."

# ── 이메일 알림 (선택) ────────────────────────────────────────────────────────
# Gmail: 구글 계정 → 보안 → 앱 비밀번호 생성
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Rocket AH <your-email@gmail.com>"

# ── 네이버 쇼핑 시세 (선택) ──────────────────────────────────────────────────
# https://developers.naver.com → 애플리케이션 등록 → 검색 API
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""
